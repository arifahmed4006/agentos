# AgentOS — Environment Variables
# Copy this file to .env and fill in your own values
# Never commit the filled-in .env file

# ---------- Database ----------
# Choose any password you want
POSTGRES_PASSWORD=your-postgres-password-here

# ---------- WhatsApp (Evolution API) ----------
# Generate with: openssl rand -hex 32
EVOLUTION_AUTH_TOKEN=your-evolution-auth-token-here

# Where Evolution API sends inbound WhatsApp messages
# Format: http://<your-n8n-vm-ip>:5678/webhook/whatsapp
N8N_WEBHOOK_URL=http://YOUR_N8N_VM_IP:5678/webhook/whatsapp

# ---------- LLM Models ----------
# Groq — DEFAULT model (free tier, no card needed)
# Get from: console.groq.com → API Keys
GROQ_API_KEY=your-groq-key-here

# Anthropic Claude — fallback
# Get from: console.anthropic.com (separate from claude.ai subscription)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Google Gemini — fallback
# Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=your-gemini-key-here

# OpenAI — optional
OPENAI_API_KEY=your-openai-key-here
OLLAMA_URL=your-cloudflare-tunnel-url-here
LITELLM_MASTER_KEY=your-litellm-master-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com
